# Football Betting Assistant - Environment Variables

# Database (Render provides this automatically)
# Sync URL: postgresql://user:password@host:port/database
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/football

# Async URL is auto-generated from DATABASE_URL_SYNC if not set
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# CORS Origins (comma-separated)
CORS_ORIGINS=https://jqhuv828m4q.feishu.cn,http://localhost:3000,http://localhost:5173

# API Configuration
API_PREFIX=/api

# App Settings
DEBUG=false
